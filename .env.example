# ==============================================================================
# Cybersecurity GRC & Compliance Management Platform
# Production Environment Variables — .env.example
# ==============================================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Replace ALL placeholder values before any production deployment
#   3. NEVER commit the actual .env file to version control (.gitignore enforces this)
#   4. In cloud deployments, inject secrets via AWS Secrets Manager, Azure Key Vault,
#      HashiCorp Vault, or Kubernetes Secrets — NOT plain env files
# ==============================================================================


# ------------------------------------------------------------------------------
# Application Core
# ------------------------------------------------------------------------------
PROJECT_NAME="Cybersecurity GRC & Compliance Management Platform"
PROJECT_VERSION="1.0.0"

# ENVIRONMENT: "development" | "staging" | "production"
ENVIRONMENT=production

# DEBUG: MUST be False in production (disables /api/docs, /api/openapi.json)
DEBUG=False

API_V1_STR=/api/v1


# ------------------------------------------------------------------------------
# Cryptographic Secrets
# ------------------------------------------------------------------------------
# Generate a cryptographically-secure 48-byte key:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotate this key every 90 days. Rotating invalidates all existing sessions.
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_48

ALGORITHM=HS256

# Session expiry in minutes (60 = 1 hour; reduce for high-security deployments)
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ------------------------------------------------------------------------------
# Database — PostgreSQL (Production)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://grc_user:CHANGE_ME_strong_db_password@postgres:5432/grc_platform

# Docker Compose variables (only used by the postgres service)
POSTGRES_DB=grc_platform
POSTGRES_USER=grc_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# NOTE for SQLite (local dev only — NOT production):
# DATABASE_URL=sqlite:///./grc_platform.db


# ------------------------------------------------------------------------------
# Secure Evidence File Storage (Evidence Vault)
# ------------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads

# Maximum file size per upload in MB
MAX_UPLOAD_SIZE_MB=25

# Comma-separated allowed MIME extensions (no executables, no archives)
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,docx,xlsx,csv,txt


# ------------------------------------------------------------------------------
# Session & Cookie Security
# ------------------------------------------------------------------------------
COOKIE_NAME=grc_session

# MUST be True in production (requires HTTPS)
COOKIE_SECURE=true

COOKIE_HTTPONLY=true

# "strict" recommended for intranet tools; "lax" for apps linked from email
COOKIE_SAMESITE=strict


# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
# Maximum login attempts per IP per minute before 429 is returned
RATE_LIMIT_LOGIN_PER_MINUTE=5


# ------------------------------------------------------------------------------
# pgAdmin (Docker Compose --profile tools only)
# ------------------------------------------------------------------------------
PGADMIN_EMAIL=admin@grc.yourdomain.com
PGADMIN_PASSWORD=CHANGE_ME_strong_pgadmin_password


# ------------------------------------------------------------------------------
# Observability (optional — extend in app/core/logging.py)
# ------------------------------------------------------------------------------
# LOG_LEVEL=INFO
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
